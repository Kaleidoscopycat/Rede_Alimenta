# Copie para .env (NÃO versionar) e preencha localmente. Nenhum valor real aqui.
# Use senha com apenas letras, números, '-' e '_' (ela entra na URL do banco).
POSTGRES_PASSWORD=
APP_DB=rede_alimenta
APP_USER=rede_alimenta
PGPORT=5433

# --- Uso FORA do Docker (python/uvicorn/streamlit direto na sua máquina) ---
DATABASE_URL=postgresql+psycopg://rede_alimenta:<SENHA>@127.0.0.1:5433/rede_alimenta
# banco de TESTE (o nome DEVE terminar em _test: o esquema é recriado a cada execução)
TEST_DATABASE_URL=postgresql+psycopg://rede_alimenta:<SENHA>@127.0.0.1:5433/rede_alimenta_test
API_BASE_URL=http://127.0.0.1:8000

# --- Docker Compose (o Compose monta DATABASE_URL a partir das variáveis acima; não use as de cima lá) ---
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8501
SIM_TAG=main

# premissas do motor de match (opcional; padrões em core/settings.py)
# MATCH_W_ML=0.5  MATCH_W_RULE=0.3  MATCH_W_DIST=0.2  MATCH_K=15  MATCH_RADIUS_KM=150  PROPOSAL_TTL_MINUTES=30  EXPIRY_SCAN_SECONDS=15
# premissas da roteirização (Fase 2 Parte 2; padrões em core/settings.py)
# ROUTE_SAFETY_MARGIN_H=2  ROUTE_DETOUR=1.35  ROUTE_SPEED_SHORT_KMH=22  ROUTE_SPEED_LONG_KMH=55  ROUTE_SERVICE_MIN=30
# premissas da doação com itens (Fase 3 Parte 1; padrões em core/settings.py)
# DONATION_MAX_ITEMS=30  DONATION_VALIDITY_SPREAD_WARN_DAYS=60  DONATION_DEFAULT_DENSITY_KG_L=1.0  DONATION_MAX_TOTAL_KG=100000
# Tokens de usuário NÃO ficam em arquivo: gere com `python -m scripts.create_user` (exibido uma única vez; só o hash vai ao banco).
# Um token POR PERFIL (ADMIN, DONOR, ORG). Só o CI/e2e define estas variáveis, no ambiente do processo (NUNCA aqui, NUNCA com valor):
#   E2E_ADMIN_TOKEN  E2E_DONOR_TOKEN  E2E_ORG_TOKEN   → `python -m scripts.create_user --role <PERFIL> ... --token-env <VARIÁVEL>`
# Sem elas o e2e gera tokens novos a cada execução.
