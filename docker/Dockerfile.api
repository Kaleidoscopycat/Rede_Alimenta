# syntax=docker/dockerfile:1
# API FastAPI (e scripts de migração/carga). Imagem enxuta em 2 estágios; usuário não-root; SEM dados brutos/simulados e SEM segredos na imagem.
# Os dados (data/gold, data/simulated, data/metadata) são montados em tempo de execução só pelo serviço `seed` do Compose.
FROM python:3.10-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# pip/setuptools/wheel atualizados ANTES de instalar as dependências (o setuptools antigo embute jaraco.context e wheel vulneráveis, achados HIGH do Trivy)
RUN pip install --upgrade pip setuptools wheel
COPY requirements-api.txt /tmp/requirements-api.txt
# setuptools/wheel só servem para instalar: removidos do venv assim que as dependências terminam (verificado: nenhuma dependência de runtime importa setuptools/pkg_resources; pytz só tenta pkg_resources como último recurso, dentro de try/except ImportError)
RUN pip install -r /tmp/requirements-api.txt \
 && pip uninstall -y setuptools wheel

FROM python:3.10-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --home-dir /app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
# Remove pip, setuptools e wheel do Python do sistema (/usr/local) e do venv (/opt/venv). Em runtime nada chama pip (CMD, HEALTHCHECK, Compose, alembic e seed usam só python -m alembic/uvicorn/streamlit/scripts), e o pip embute libs vendored (msgpack, urllib3, setuptools) com CVEs que nenhuma versão do pip corrige ainda. O pip fica só no estágio builder.
# Depois da remoção, apaga resquícios (diretórios, dist-info, executáveis) e FALHA o build se o pip ainda for importável ou se sobrar rastro dele.
RUN /opt/venv/bin/python -m pip uninstall -y pip setuptools wheel \
 && /usr/local/bin/python -m pip uninstall -y pip setuptools wheel \
 && rm -rf /opt/venv/lib/python3*/site-packages/pip /opt/venv/lib/python3*/site-packages/pip-*.dist-info /usr/local/lib/python3*/site-packages/pip /usr/local/lib/python3*/site-packages/pip-*.dist-info /opt/venv/bin/pip /opt/venv/bin/pip3* /usr/local/bin/pip /usr/local/bin/pip3* \
 && ! /opt/venv/bin/python -c "import pip" 2>/dev/null \
 && ! /usr/local/bin/python -c "import pip" 2>/dev/null \
 && [ -z "$(find /usr/local /opt/venv \( -name 'pip-*.dist-info' -o -path '*/site-packages/pip' \))" ]
# somente o necessário para executar API, migrações e carga (sem tests/, docs/, data/, eda/, pipelines de ingestão)
COPY --chown=app:app alembic.ini ./alembic.ini
COPY --chown=app:app core ./core
COPY --chown=app:app database ./database
COPY --chown=app:app api ./api
COPY --chown=app:app match ./match
COPY --chown=app:app routing ./routing
COPY --chown=app:app ml/__init__.py ml/dataset.py ./ml/
COPY --chown=app:app ml/semantic ./ml/semantic
COPY --chown=app:app ml/artifacts ./ml/artifacts
COPY --chown=app:app simulation/__init__.py simulation/params.py ./simulation/
COPY --chown=app:app simulation/config ./simulation/config
COPY --chown=app:app simulation/params ./simulation/params
COPY --chown=app:app pipelines/__init__.py pipelines/geo.py ./pipelines/
COPY --chown=app:app scripts/bootstrap_db.py scripts/create_user.py ./scripts/
COPY --chown=app:app security/reports ./security/reports
USER app
# Porta: a plataforma (Render) define PORT; sem ela vale 8000 (Compose/desenvolvimento). Forma shell com `exec` para o uvicorn receber os sinais de parada.
ENV PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 \
  CMD ["python", "-c", "import os,sys,urllib.request; p=os.environ.get('PORT','8000'); sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/health' % p, timeout=4).status == 200 else 1)"]
CMD ["sh", "-c", "exec uvicorn api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
