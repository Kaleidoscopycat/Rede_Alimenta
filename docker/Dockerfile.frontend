# syntax=docker/dockerfile:1
# Interface Streamlit (Fase 2 Parte 1). Fala SOMENTE com a API por HTTP: sem banco, sem dados e sem segredos na imagem.
FROM python:3.10-slim AS builder
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# pip/setuptools/wheel atualizados ANTES de instalar as dependências (o setuptools antigo embute jaraco.context e wheel vulneráveis, achados HIGH do Trivy)
RUN pip install --upgrade pip setuptools wheel
COPY requirements-frontend.txt /tmp/requirements-frontend.txt
# setuptools/wheel só servem para instalar: removidos do venv assim que as dependências terminam (verificado: nenhuma dependência de runtime importa setuptools/pkg_resources; pytz só tenta pkg_resources como último recurso, dentro de try/except ImportError)
RUN pip install -r /tmp/requirements-frontend.txt \
 && pip uninstall -y setuptools wheel

FROM python:3.10-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    HOME=/home/app \
    STREAMLIT_BROWSER_GATHER_USAGE_STATS=false \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501
RUN groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app --shell /usr/sbin/nologin app
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
# Remove pip, setuptools e wheel do Python do sistema (/usr/local) e do venv (/opt/venv). Em runtime nada chama pip (CMD, HEALTHCHECK, Compose, alembic e seed usam só python -m alembic/uvicorn/streamlit/scripts), e o pip embute libs vendored (msgpack, urllib3, setuptools) com CVEs que nenhuma versão do pip corrige ainda. O pip fica só no estágio builder.
# Depois da remoção, apaga resquícios (diretórios, dist-info, executáveis) e FALHA o build se o pip ainda for importável ou se sobrar rastro dele.
RUN /opt/venv/bin/python -m pip uninstall -y pip setuptools wheel \
 && /usr/local/bin/python -m pip uninstall -y pip setuptools wheel \
 && rm -rf /opt/venv/lib/python3*/site-packages/pip /opt/venv/lib/python3*/site-packages/pip-*.dist-info /usr/local/lib/python3*/site-packages/pip /usr/local/lib/python3*/site-packages/pip-*.dist-info /opt/venv/bin/pip /opt/venv/bin/pip3* /usr/local/bin/pip /usr/local/bin/pip3* \
 && ! /opt/venv/bin/python -c "import pip" 2>/dev/null \
 && ! /usr/local/bin/python -c "import pip" 2>/dev/null \
 && [ -z "$(find /usr/local /opt/venv \( -name 'pip-*.dist-info' -o -path '*/site-packages/pip' \))" ]
COPY --chown=app:app app ./app
USER app
EXPOSE 8501
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD ["python", "-c", "import sys,urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=4).status == 200 else 1)"]
# Escuta em 0.0.0.0 DENTRO do contêiner (necessário para o encaminhamento de porta); o Compose publica somente em 127.0.0.1 no host.
CMD ["streamlit", "run", "app/streamlit_app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true", "--browser.gatherUsageStats=false"]
